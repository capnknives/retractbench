    family-names: Elliot
    email: captain.knives@gmail.com
version: 0.1.0
license: MIT
repository-code: "https://github.com/capnknives/retractbench"
keywords:
  - knowledge editing
  - model editing
  - edit reversal
  - ROME
  - evaluation
  - benchmark
